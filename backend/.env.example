GEMINI_KEY_1=your_gemini_key_here
GEMINI_KEY_2=your_gemini_key_here
GEMINI_KEY_3=your_gemini_key_here
GEMINI_KEY_4=your_gemini_key_here
GEMINI_KEY_5=your_gemini_key_here
JWT_SECRET=replace_with_at_least_32_char_random_string
DATABASE_URL=postgresql://user:password@host:5432/dbname
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ----- LLM Provider Selection -----
# Options: "gemini" (default), "ollama", "openrouter"
LLM_PROVIDER=gemini

# ----- Ollama Config (Local) -----
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ----- OpenRouter Config -----
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
